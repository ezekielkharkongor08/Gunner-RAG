# ---------------------------------------------------------------
# Arsenal Weki — environment configuration
# Copy this file to .env and adjust the values for your machine.
# Secrets (passwords, keys) live here only, never in settings.yaml.
# ---------------------------------------------------------------

# --- PostgreSQL (pgvector) -------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ezekiel
POSTGRES_PASSWORD=08062006
POSTGRES_DB=arsenal_rag

# pgvector table/collection name used by langchain-postgres
PGVECTOR_COLLECTION=arsenal_documents

# --- Ollama (chat + embeddings) --------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=dengcao/Qwen3-Embedding-0.6B:Q8_0
LLM_TEMPERATURE=0.2

# Prefixes prepended to text before embedding (default empty).
# Example for nomic-embed-text: search_document:  /  search_query:
# Changing the model or prefixes requires reset=True on re-index.
EMBEDDING_DOC_PREFIX=
EMBEDDING_QUERY_PREFIX=

# --- Wikipedia fetching (ingestion Mode B) ---------------------
WIKIPEDIA_LANG=en
WIKIPEDIA_USER_AGENT=arsenal-weki-rag/0.1 (ezekielkharkongorgaming@gmail.com)
WIKIPEDIA_LOAD_MAX_DOCS=2
WIKIPEDIA_MAX_CHARS=200000

# --- Chunking / retrieval --------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Chunks shorter than this get folded into the next one (stops bare headings
# becoming chunks of their own).
CHUNK_MIN_SIZE=120
# Log a warning if any chunk is longer than this many characters.
CHUNK_MAX_WARN=1000

# How many results to hand to the LLM per question.
TOP_K=5

# Retrieval settings
QUERY_REWRITE_COUNT=3
RETRIEVE_K=10
RERANK_TOP_N=5
SCORE_THRESHOLD=0.4

# --- CSV ingestion ---------------------------------------------
# How many data rows go in one CSV chunk (a row is never split).
CSV_ROWS_PER_CHUNK=12
# CSV row style: "pairs" (Key: value, ...) or "sentence" (uses ROW_TEMPLATE).
CSV_ROW_STYLE=pairs
