# Copy this file to .env and fill in your own values.
# .env is read by src.config. Do not commit secrets.

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=arsenal_rag

# pgvector collection used by the app (Phase 1 never writes here).
PGVECTOR_COLLECTION=arsenal_documents

# Optional: a full connection string wins over the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/arsenal_rag

# Drop documents shorter than this many characters after cleaning.
CLEAN_MIN_LENGTH=25

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL is the key the code reads; the older name OLLAMA_MODEL also works.
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=dengcao/Qwen3-Embedding-0.6B:Q8_0
LLM_TEMPERATURE=0.6

# --- Wikipedia (MediaWiki Action API) ---
# WIKIPEDIA_LANG is the key the code reads; WIKIPEDIA_LANGUAGE also works.
WIKIPEDIA_LANG=en
WIKIPEDIA_USER_AGENT=arsenal-weki-rag/0.1 (you@example.com)
# Leave empty to use https://{WIKIPEDIA_LANG}.wikipedia.org/w/api.php
WIKIPEDIA_API_URL=
WIKIPEDIA_TIMEOUT=30
WIKIPEDIA_MAX_RETRIES=3

# Prefixes prepended before embedding (default empty).
# Qwen3-Embedding does NOT use search_document:/search_query:.
EMBEDDING_DOC_PREFIX=
EMBEDDING_QUERY_PREFIX=

# Qwen3-Embedding query instruction. Queries only; documents get nothing.
# Code format: "Instruct: <text>\nQuery:<question>"
EMBEDDING_QUERY_INSTRUCTION=Given a question about Arsenal F.C., retrieve Wikipedia passages that answer it
EMBEDDING_QUERY_INSTRUCTION_ENABLED=false

# --- Chunking ---
# CHUNK_SIZE is the BODY budget. The title/section header is added on top.
CHUNK_SIZE=900
CHUNK_OVERLAP=120
# A short body piece is folded into a neighbour. Never dropped.
CHUNK_MIN_SIZE=150
# Warn when a whole chunk (body + header) is longer than this.
CHUNK_MAX_WARN=1200
# Add "<title>\nSection: <path>" to every chunk before embedding.
CHUNK_HEADER_ENABLED=true
# Chunks embedded per request.
INDEX_BATCH_SIZE=32

# --- Section assembly (runs before splitting) ---
# Merge sections shorter than this into a child/sibling/parent.
MIN_SECTION_CHARS=250
# Drop an unmergeable section below this many characters.
MIN_SECTION_KEEP=60
# How many merge passes to run.
MIN_SECTION_MAX_PASSES=3
# Default caption limit (YAML patterns can override it).
BOILERPLATE_MAX_CHARS=800

# Season metadata. Title only keeps the list small.
SEASONS_FROM_TEXT=false
SEASONS_MAX=8

# --- Wikipedia fetch cache ---
# Keeps every experiment on exactly the same text.
USE_FETCH_CACHE=true
FETCH_CACHE_DIR=data/cache
REFRESH_FETCH_CACHE=false

# --- Retrieval ---
QUERY_REWRITE_COUNT=3
QUERY_REWRITE_TEMPERATURE=0.0
# How many chunks to fetch per query variant.
RETRIEVE_K=20
# How many chunks to return after merging.
FINAL_TOP_N=12
# Cosine distance threshold: 0 = identical, 1 = opposite.
SCORE_THRESHOLD=0.7

# --- Eval defaults ---
EVAL_TOP_K=8
EVAL_HIT_AT=1,3,5,8
EVAL_COLLECTION_PREFIX=arsenal_eval_
EVAL_RESULTS_DIR=eval/results
TEST_REPORT_PATH=test_report.txt

# --- Phase 2: answers and retrieval ---
# Context window passed to the chat model (Ollama num_ctx).
OLLAMA_NUM_CTX=8192
# Temperature for the answer/summary model. Rewriting uses QUERY_REWRITE_TEMPERATURE.
ANSWER_TEMPERATURE=0.1
# Rewriting switch: off | always | fallback. Fallback rewrites only when the
# first search is weak -- the 2.7 grid showed unconditional rewriting was worse.
QUERY_REWRITE_MODE=fallback
# Fallback threshold: rewrite when the best first-search distance is above this.
QUERY_REWRITE_WEAK_SCORE=0.65
# Legacy switch, used only when QUERY_REWRITE_MODE is absent (true -> always).
QUERY_REWRITE_ENABLED=false
# Condense a short follow-up ("who did they beat?") into a standalone question
# before searching, using the recent conversation.
QUERY_CONDENSE_ENABLED=true
# A question with at most this many words can be treated as a follow-up.
FOLLOWUP_MAX_WORDS=6
# Recent (question, answer) pairs the follow-up condenser may read. One keeps
# the latest subject: with two, "who did they beat at home?" merged two months.
CONDENSE_HISTORY_TURNS=1
# How many (question, answer) pairs the chat loop keeps in memory.
CHAT_HISTORY_TURNS=4
# Strip the stored "title + Section:" header before sending chunks to the LLM.
CONTEXT_STRIP_HEADER=true
# Nothing passes SCORE_THRESHOLD -> false: return no chunks; true: return the best one.
RETRIEVAL_FALLBACK_ON_EMPTY=false
# Questions that name a section ("November", "kits") go straight to that section.
SECTION_ROUTING_ENABLED=true
# Maximum chunks read from one section (keeps the prompt inside OLLAMA_NUM_CTX).
MAX_SECTION_CHUNKS=16
# How to drop weak results: relative (best + RELATIVE_MARGIN), absolute
# (SCORE_THRESHOLD) or none (always keep the top FINAL_TOP_N).
RETRIEVAL_GATE=relative
# In relative mode: keep chunks scoring within this distance of the best one.
RELATIVE_MARGIN=0.15
